			column: region

	partition Regions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "regions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"nuts_id", type text}, {"region", type text}, {"country", type text}, {"country_name", type text}, {"total_pop", type number}, {"share_over_65", type number}, {"poverty_rate_pct", type number}, {"is_eu27", type logical}, {"expected_annual_exposure", type number}, {"expected_annual_exposure_closed", type number}, {"shared_basin_share", type number}, {"basin_area_share", type number}, {"basin_countries_max", Int64.Type}, {"apsfr_share", type number}, {"apsfr_declared", type logical}, {"apsfr_country_reported", type logical}, {"built_share_exposed_rp100", type number}, {"natura2000_flooded_share_rp100", type number}, {"gdp_meur", type number}, {"pop_density_per_km2", type number}, {"household_income_pps_per_hab", type number}, {"change_pct_ensemble_median_2011_2040", type number}, {"change_pct_ensemble_p25_2011_2040", type number}, {"change_pct_ensemble_p75_2011_2040", type number}, {"ensemble_agrees_on_sign_2011_2040", type logical}, {"change_pct_ensemble_median_2041_2070", type number}, {"change_pct_ensemble_p25_2041_2070", type number}, {"change_pct_ensemble_p75_2041_2070", type number}, {"ensemble_agrees_on_sign_2041_2070", type logical}, {"change_pct_ensemble_median_2071_2100", type number}, {"change_pct_ensemble_p25_2071_2100", type number}, {"change_pct_ensemble_p75_2071_2100", type number}, {"ensemble_agrees_on_sign_2071_2100", type logical}, {"shared_with", type text}, {"shared_basins", type text}, {"main_shared_basin", type text}}, "en-US")
