# Copy to .env and fill in what you have. Nothing here is required: every
# integration degrades to "unavailable" rather than inventing a value, so the kit
# runs end to end with this file empty.
#
# .env is gitignored. Never commit a real key.

# --- Generation ------------------------------------------------------------
# Claude when ANTHROPIC_API_KEY is set, then Groq when its key is set, then
# Ollama. A rate limit, an overload or a dead network moves to the next one; a
# wrong key or model name does not. The local fallback is not a nicety: a rate
# limit mid-jury-session is the realistic failure.
# ANTHROPIC_MODEL defaults to claude-opus-5-5; claude-sonnet-5-5 is cheaper and faster.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GROQ_API_KEY=
# Optional extra keys, tried in turn when one is rate-limited (rag.groq_keys).
# Each one routes the demo online exactly like GROQ_API_KEY.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Tracing (LangSmith) ---------------------------------------------------
# Optional, and genuinely useful here: with these set, every node of the
# src/workflow.py graph is traced - prompt, output, latency, token count - which
# is the accountability evidence the responsible-AI deliverable asks for, written
# automatically instead of reconstructed at 17:00.
#
# WHAT IT COSTS: traces are sent to LangChain's servers. Prompts and model
# outputs leave this machine. The corpus is public EU documents and the exposure
# table is open data, so that is acceptable here - but say so in the brief, and
# do not enable it on anything you would not publish.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=flood-policy-kit

# --- Reported events (optional) --------------------------------------------
# GDELT needs no key and is the default. NEWSAPI_KEY is only a recency top-up for
# src/events.py, and events.py is itself only a last-resort check: the observed
# satellite flood catalogue replaced it. Leave this empty unless you have a
# reason.
NEWSAPI_KEY=

# --- JRC Risk Data Hub (optional) ------------------------------------------
# Needs an EU Login account; the token expires after 10 hours, so it cannot be
# baked in. Fetch it at run time and cache the responses to disk.
RDH_BEARER_TOKEN=

# --- Copernicus Climate Data Store -----------------------------------------
# Only `scripts/fetch_cds_member.py` reads these, to request ensemble members
# one at a time (each under the form's 1000 cap) and verify each file against
# the request. `~/.cdsapirc` works instead. `src/climate.py` reads whatever
# `.nc` files sit in `data/raw/download/cds_hydrology_projections/` and needs
# no credential, so nothing else in the repository needs a CDS account.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Approve guard (optional) ----------------------------------------------
# Shared secret for POST /api/approve, sent as the X-Approve-Token header. Unset:
# any caller that reaches the API may approve; docker-compose.yml publishes it on
# 127.0.0.1 only. Set it if the API is ever exposed beyond this machine; the
# React draft panel then shows a token field and the approver types it there.
# Streamlit writes the brief without the API, so this token does not guard it.
FLOOD_APPROVE_TOKEN=
